APP_NAME=XHS Growth Intelligence Agent
APP_ENV=dev
DEBUG=true

# 数据库配置
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/xhs_growth

#爬虫设置
XHS_CRAWLER_PROVIDER=mock
CRAWLER_HEADLESS=false
CRAWLER_TIMEOUT_MS=15000

#LLM配置
# LLM_PROVIDER 可选：qwen / zhipu / deepseek / mock
# Qwen: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Zhipu: LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_CONTROL_SEMANTIC_MODEL=qwen3.7-flash-2026-07-15
LLM_TIMEOUT_SECONDS=30
AGENT_WORKFLOW_TOOL_TIMEOUT_SECONDS=150
LLM_RESEARCH_ANALYSIS_MODEL=qwen3.7-flash-2026-07-15
LLM_RESEARCH_ANALYSIS_TIMEOUT_SECONDS=120
LLM_RESEARCH_ANALYSIS_ENABLE_THINKING=false
LLM_CONTENT_STRATEGY_TIMEOUT_SECONDS=120
LLM_DRAFT_GENERATION_TIMEOUT_SECONDS=120
LLM_DRAFT_REVIEW_MODEL=qwen3.7-flash-2026-07-15
LLM_DRAFT_REVIEW_TIMEOUT_SECONDS=120
LLM_POST_PUBLISH_REVIEW_MODEL=qwen3.7-flash-2026-07-15
LLM_POST_PUBLISH_REVIEW_TIMEOUT_SECONDS=120
LLM_POST_PUBLISH_REVIEW_ENABLE_THINKING=false
XHS_MCP_BASE_URL=http://host.docker.internal:18060
XHS_MCP_HOST_HEADER=localhost:18060
XHS_MCP_TIMEOUT_SECONDS=60
LLM_DRAFT_REVISION_MODEL=qwen3.7-flash-2026-07-15
LLM_DRAFT_REVISION_TIMEOUT_SECONDS=120
LLM_DRAFT_REVISION_ENABLE_THINKING=false
LLM_MAX_RETRIES=2
LLM_INPUT_PRICE_PER_1M=0
LLM_OUTPUT_PRICE_PER_1M=0
AGENT_ENTRY_MODE=conversation_v2
