APP_NAME=XHS Growth Intelligence Agent
APP_ENV=dev
DEBUG=true

# 数据库配置
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/xhs_growth

#爬虫设置
XHS_CRAWLER_PROVIDER=mock
CRAWLER_HEADLESS=false
CRAWLER_TIMEOUT_MS=15000

#LLM配置
# LLM_PROVIDER 可选：qwen / zhipu / deepseek / mock
# Qwen: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Zhipu: LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_INPUT_PRICE_PER_1M=0
LLM_OUTPUT_PRICE_PER_1M=0
